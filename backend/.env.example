# Environment: development | test | production
APP_ENV=development

# CoinGecko
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
REQUEST_TIMEOUT=10
LOG_LEVEL=INFO

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=4820
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=replace_with_a_secret
MYSQL_DATABASE=crypto_tracker
MYSQL_TEST_DATABASE=crypto_tracker_test
MYSQL_POOL_SIZE=10
# Tiempo máximo para esperar una conexión libre del pool.
MYSQL_POOL_ACQUIRE_TIMEOUT_SECONDS=2
# Obligatorio en production para validar TLS contra MySQL remoto.
# MYSQL_SSL_CA=C:\path\to\ca.pem

# JWT
# Generate a unique secret of at least 32 bytes for each environment.
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=30

# CORS (origins separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate limiting del login
RATE_LIMIT_LOGIN_MAX_REQUESTS=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_REGISTER_MAX_REQUESTS=5
RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600
RATE_LIMIT_COIN_UPDATE_MAX_REQUESTS=10
RATE_LIMIT_COIN_UPDATE_WINDOW_SECONDS=60
RATE_LIMIT_SSE_MAX_CONNECTIONS_PER_USER=2

# Actualización periódica de precios (desactivada por defecto)
PRICE_UPDATE_ENABLED=false
PRICE_UPDATE_INTERVAL_SECONDS=300
